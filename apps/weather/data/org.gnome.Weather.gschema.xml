<?xml version="1.0" encoding="UTF-8"?>
<!-- GNOME-compatible schema for the keys Helix Weather uses. Install only
     when the schema is not already provided by the system. -->
<schemalist>
  <schema path="/org/gnome/Weather/" id="org.gnome.Weather">
    <key type="i" name="window-width"><default>0</default><summary>Window width</summary></key>
    <key type="i" name="window-height"><default>0</default><summary>Window height</summary></key>
    <key type="b" name="window-maximized"><default>false</default><summary>Window maximized</summary></key>
  </schema>
</schemalist>
