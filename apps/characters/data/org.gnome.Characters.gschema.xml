<?xml version="1.0" encoding="UTF-8"?>
<!-- GNOME-compatible schema for the keys Helix Characters uses, matching the
     installed org.gnome.Characters schema (same names, types, defaults).
     Install only when the schema is not already provided by the system. -->
<schemalist gettext-domain="org.gnome.Characters">
  <schema id="org.gnome.Characters" path="/org/gnome/Characters/">
    <key name="recent-characters" type="as">
      <default>[]</default>
    </key>
    <key name="max-recent-characters" type="u">
      <default>100</default>
      <summary>Maximum recent characters</summary>
    </key>
  </schema>
</schemalist>
