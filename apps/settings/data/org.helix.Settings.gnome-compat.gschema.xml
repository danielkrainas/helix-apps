  <schema id="org.gnome.desktop.a11y.magnifier" path="/org/gnome/desktop/a11y/magnifier/">
    <key name="mag-factor" type="d">
      <default>2.0</default>
      <range min="0.1" max="32.0"/>
    </key>
    <key name="screen-position" enum="org.helix.Settings.compat.ScreenPosition">
      <default>'full-screen'</default>
    </key>
    <key name="mouse-tracking" enum="org.helix.Settings.compat.MouseTracking">
      <default>'proportional'</default>
    </key>
    <key name="show-cross-hairs" type="b">
      <default>false</default>
    </key>
    <key name="cross-hairs-clip" type="b">
      <default>false</default>
    </key>
    <key name="cross-hairs-thickness" type="i">
      <default>8</default>
    </key>
    <key name="cross-hairs-length" type="i">
      <default>4096</default>
      <range min="20" max="4096"/>
