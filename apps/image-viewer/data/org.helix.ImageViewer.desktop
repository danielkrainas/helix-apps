[Desktop Entry]
Name=Image Viewer
Comment=View images
Keywords=Picture;Slideshow;Graphics;Photo;Image;
Exec=helix-image-viewer %U
Icon=image-viewer
Terminal=false
Type=Application
Categories=GTK;Graphics;Viewer;
MimeType=image/jpeg;image/png;image/gif;image/webp;image/tiff;image/bmp;image/x-bmp;image/vnd.microsoft.icon;image/x-icon;image/svg+xml;image/x-tga;image/x-portable-pixmap;image/x-portable-graymap;image/x-portable-bitmap;image/x-portable-anymap;image/x-xpixmap;image/x-xbitmap;image/heif;image/avif;image/qoi;
StartupNotify=true
DBusActivatable=false
