[Desktop Entry]
Name=Audio Player
Comment=Play audio files
Keywords=music;sound;audio;player;waveform;
Exec=helix-audio-player %u
Icon=org.helix.AudioPlayer
Terminal=false
Type=Application
Categories=GTK;AudioVideo;Audio;Player;
MimeType=audio/mpeg;audio/x-mp3;audio/ogg;audio/x-vorbis+ogg;audio/x-opus+ogg;audio/flac;audio/x-flac;audio/x-wav;audio/wav;audio/aac;audio/mp4;audio/x-m4a;audio/webm;audio/x-aiff;audio/x-ms-wma;audio/x-matroska;
StartupNotify=true
DBusActivatable=false
