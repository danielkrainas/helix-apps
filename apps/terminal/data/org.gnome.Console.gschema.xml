<?xml version="1.0" encoding="UTF-8"?>
<!-- GNOME-compatible org.gnome.Console schema for the keys Helix Terminal
     uses; key names, types, enum values, ranges and defaults match the
     published GNOME Console schema. Install only when the schema is not
     already provided by the system. -->
<schemalist gettext-domain="kgx">
  <enum id="org.gnome.Console.Theme">
    <value nick="auto" value="0"/>
    <value nick="night" value="1"/>
    <value nick="day" value="2"/>
    <value nick="hacker" value="3"/>
  </enum>

  <schema id="org.gnome.Console" path="/org/gnome/Console/">
    <key name="theme" enum="org.gnome.Console.Theme">
      <default>'night'</default>
    </key>
    <key name="font-scale" type="d">
      <range min="0.5" max="4.0"/>
      <default>1.0</default>
    </key>
    <key name="custom-font" type="s">
      <default>""</default>
    </key>
    <key name="use-system-font" type="b">
      <default>true</default>
    </key>
    <key name="shell" type="as">
      <default>[]</default>
    </key>
    <key name="scrollback-lines" type="x">
      <default>10000</default>
    </key>
    <key name="last-window-size" type="(ii)">
      <default>(-1, -1)</default>
    </key>
    <key name="last-window-maximised" type="b">
      <default>false</default>
    </key>
    <key name="restore-window-size" type="b">
      <default>true</default>
    </key>
    <key name="audible-bell" type="b">
      <default>true</default>
    </key>
    <key name="visual-bell" type="b">
      <default>true</default>
    </key>
  </schema>
</schemalist>
