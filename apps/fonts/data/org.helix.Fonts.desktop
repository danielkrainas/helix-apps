[Desktop Entry]
Name=Fonts
Comment=View and install fonts
Keywords=fonts;fontface;typeface;install;preview;
Exec=helix-fonts %F
Icon=org.helix.Fonts
Terminal=false
Type=Application
Categories=GTK;Utility;
MimeType=font/ttf;font/otf;font/collection;font/sfnt;application/x-font-ttf;application/x-font-otf;
StartupNotify=true
DBusActivatable=false
