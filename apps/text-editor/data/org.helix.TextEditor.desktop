[Desktop Entry]
Name=Text Editor
Comment=Edit text files
Keywords=Text;Plaintext;Write;Notepad;Editor;
Exec=helix-text-editor %U
Icon=accessories-text-editor
Terminal=false
Type=Application
Categories=GTK;Utility;TextEditor;
MimeType=text/plain;text/x-log;text/markdown;text/csv;application/x-shellscript;
StartupNotify=true
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=helix-text-editor
